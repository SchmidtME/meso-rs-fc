clc
close all
clear all

%% Specifications

% donut radii
distEdgeRange = 4:0.5:10;

% Define the base directory where the subject folders are stored
baseDirectory = '/space/ardebil/1/users/Others/Marianna/FC_7T_Coronal/Controls/Results';
% subjects
subNames = {'aman', 'ylri', 'auil', 'arak', 'aroo', 'atib', 'imyy', 'chss', 'evad', 'haas', 'rcgr'};
layers = {'0-2', '4-6', '8-10'};

%% Load data (shifted version)

% Initialize cell array to store meanAbsR for each subject
meanAbsRAll = zeros(length(subNames),length(layers),length(distEdgeRange),2,2);

for n = 1:length(subNames)
    for l = 1:length(layers)
        subjectDir = fullfile(baseDirectory, ['V1_layers_' layers{l} '_intrahemispheric'], subNames{n});
        matFilePath = fullfile(subjectDir, 'meanAbsR_Denoised_excl_3mm.mat');
        data = load(matFilePath, 'meanAbsR');
        meanAbsRAll(n,l,:,:,:) = data.meanAbsR;
    end
end

%% ANOVA (for shifted version)

% meanAbsRAll size: subjects, layers, distances, H1 H0, hemis
% mean over hemis
meanAbsRAll_mean = mean(meanAbsRAll,5);

STATS = [
  meanAbsRAll_mean(:,1,1,1) meanAbsRAll_mean(:,2,1,1) meanAbsRAll_mean(:,1,1,1) ...
  meanAbsRAll_mean(:,1,2,1) meanAbsRAll_mean(:,2,2,1) meanAbsRAll_mean(:,1,2,1) ...
  meanAbsRAll_mean(:,1,3,1) meanAbsRAll_mean(:,2,3,1) meanAbsRAll_mean(:,1,3,1) ...
  meanAbsRAll_mean(:,1,4,1) meanAbsRAll_mean(:,2,4,1) meanAbsRAll_mean(:,1,4,1) ...
  meanAbsRAll_mean(:,1,5,1) meanAbsRAll_mean(:,2,5,1) meanAbsRAll_mean(:,1,5,1) ...
  meanAbsRAll_mean(:,1,6,1) meanAbsRAll_mean(:,2,6,1) meanAbsRAll_mean(:,1,6,1) ...
  meanAbsRAll_mean(:,1,7,1) meanAbsRAll_mean(:,2,7,1) meanAbsRAll_mean(:,1,7,1) ...
  meanAbsRAll_mean(:,1,8,1) meanAbsRAll_mean(:,2,8,1) meanAbsRAll_mean(:,1,8,1) ...
  meanAbsRAll_mean(:,1,9,1) meanAbsRAll_mean(:,2,9,1) meanAbsRAll_mean(:,1,9,1) ...
  meanAbsRAll_mean(:,1,10,1) meanAbsRAll_mean(:,2,10,1) meanAbsRAll_mean(:,1,10,1) ...
  meanAbsRAll_mean(:,1,11,1) meanAbsRAll_mean(:,2,11,1) meanAbsRAll_mean(:,1,11,1) ...
  meanAbsRAll_mean(:,1,12,1) meanAbsRAll_mean(:,2,12,1) meanAbsRAll_mean(:,1,12,1) ...
  meanAbsRAll_mean(:,1,13,1) meanAbsRAll_mean(:,2,13,1) meanAbsRAll_mean(:,1,13,1) ...
  meanAbsRAll_mean(:,1,1,2) meanAbsRAll_mean(:,2,1,2) meanAbsRAll_mean(:,1,1,2) ...
  meanAbsRAll_mean(:,1,2,2) meanAbsRAll_mean(:,2,2,2) meanAbsRAll_mean(:,1,2,2) ...
  meanAbsRAll_mean(:,1,3,2) meanAbsRAll_mean(:,2,3,2) meanAbsRAll_mean(:,1,3,2) ...
  meanAbsRAll_mean(:,1,4,2) meanAbsRAll_mean(:,2,4,2) meanAbsRAll_mean(:,1,4,2) ...
  meanAbsRAll_mean(:,1,5,2) meanAbsRAll_mean(:,2,5,2) meanAbsRAll_mean(:,1,5,2) ...
  meanAbsRAll_mean(:,1,6,2) meanAbsRAll_mean(:,2,6,2) meanAbsRAll_mean(:,1,6,2) ...
  meanAbsRAll_mean(:,1,7,2) meanAbsRAll_mean(:,2,7,2) meanAbsRAll_mean(:,1,7,2) ...
  meanAbsRAll_mean(:,1,8,2) meanAbsRAll_mean(:,2,8,2) meanAbsRAll_mean(:,1,8,2) ...
  meanAbsRAll_mean(:,1,9,2) meanAbsRAll_mean(:,2,9,2) meanAbsRAll_mean(:,1,9,2) ...
  meanAbsRAll_mean(:,1,10,2) meanAbsRAll_mean(:,2,10,2) meanAbsRAll_mean(:,1,10,2) ...
  meanAbsRAll_mean(:,1,11,2) meanAbsRAll_mean(:,2,11,2) meanAbsRAll_mean(:,1,11,2) ...
  meanAbsRAll_mean(:,1,12,2) meanAbsRAll_mean(:,2,12,2) meanAbsRAll_mean(:,1,12,2) ...
  meanAbsRAll_mean(:,1,13,2) meanAbsRAll_mean(:,2,13,2) meanAbsRAll_mean(:,1,13,2) ...
  ];

ts = arrayfun(@(x) sprintf('t%d', x), 1:78, 'UniformOutput', false);

t =array2table(STATS,'VariableNames', ts);

within = table(...
    repmat({'A'; 'B'; 'C'}, 13, 1), ... % effect of layer
    repmat({'AA'; 'AA'; 'AA'; 'BB'; 'BB'; 'BB'; 'CC'; 'CC'; 'CC'; ...
    'DD'; 'DD'; 'DD'; 'EE'; 'EE'; 'EE'; 'FF'; 'FF'; 'FF'; ...
    'GG'; 'GG'; 'GG'; 'HH'; 'HH'; 'HH'; 'II'; 'II'; 'II'; ...
    'JJ'; 'JJ'}, 2, 1), ... % effect of beta
    [repmat({'AAA'}, 9, 1); repmat({'BBB'}, 9, 1)], ... % effect of type
    'VariableNames', {'Layer', 'Beta', 'Type'});

rm = fitrm(t,'t1-t18~1','WithinDesign',within)
disp('Comparison between beta & layer & type for interhemispheric rs-FC')
ranovatbl = ranova(rm,'WithinModel','Layer+Beta+Type+Layer*Type+Layer*Beta+Beta*Layer+Beta*Type+Beta*Type*Layer')
